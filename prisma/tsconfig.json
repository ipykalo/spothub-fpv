{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The package has no "type": "module", so node16 resolves seed.ts as
    // CommonJS — which is what ts-node runs. `bundler` is not available here:
    // nothing bundles this file.
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["seed.ts"]
}
