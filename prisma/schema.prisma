// SpotHub FPV — see Notion → Architecture & Database Schemas.
//
// Every owned row carries ownerId from day one, even while there is one user.
// Retrofitting ownership into queries later is the expensive part; adding a
// second row to `users` is free.

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  // musl target is required for the Alpine runtime image, otherwise the query
  // engine fails at runtime with a cryptic "could not locate engine" error.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

enum Role {
  USER
  ADMIN
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  role        Role     @default(USER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
  builds        Build[]
  parts         Part[]
  assets        Asset[]
  logImports    LogImport[]
  logFiles      LogFile[]
  sessions      Session[]
  flights       Flight[]

  spots        Spot[]
  comments     Comment[]
  commentReads CommentRead[]
  posts        Post[]
  likes        Like[]

  @@map("users")
}

enum AuthProvider {
  GOOGLE
  DISCORD
}

/// A federated identity. Kept in its own table rather than a `googleId`
/// column so adding Discord later is additive rather than a migration.
model AuthIdentity {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  provider  AuthProvider
  /// The provider's stable subject id — Google's `sub`, never the email.
  /// Emails change; subjects do not.
  subject   String
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

/// One issued refresh token. Rotation replaces a token on every use; presenting
/// an already-rotated token means it leaked, so the whole family is revoked.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the token. The raw value only ever lives in the cookie.
  tokenHash    String    @unique @map("token_hash")
  /// Shared by every token descended from one login, so a detected reuse can
  /// revoke the entire chain rather than a single link.
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------------ hangar

enum BuildClass {
  WHOOP
  THREE_INCH
  FIVE_INCH
  SEVEN_INCH
  CINEWHOOP
  LONG_RANGE
  WING
}

enum BuildStatus {
  PLANNING
  ACTIVE
  /// Grounded, waiting on a part. Every pilot has one.
  DOWN
  RETIRED
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Build {
  id            String      @id @default(uuid()) @db.Uuid
  ownerId       String      @map("owner_id") @db.Uuid
  name          String
  slug          String
  buildClass    BuildClass? @map("build_class")
  status        BuildStatus @default(PLANNING)
  visibility    Visibility  @default(PRIVATE)
  weightG       Int?        @map("weight_g")
  hasGps        Boolean     @default(false) @map("has_gps")
  descriptionMd String?     @map("description_md")
  /// The photo shown on the build card. One of this build's linked assets;
  /// SetNull so deleting the photo does not delete the quad.
  coverAssetId  String?     @map("cover_asset_id") @db.Uuid
  builtOn       DateTime?   @map("built_on") @db.Date
  retiredOn     DateTime?   @map("retired_on") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cover        Asset?        @relation("BuildCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  parts        BuildPart[]
  repairs      Repair[]
  configs      Config[]
  flights      Flight[]
  comments     Comment[]
  commentReads CommentRead[]
  postLinks    PostBuild[]
  likes        Like[]

  @@unique([ownerId, slug])
  @@index([ownerId, status])
  @@map("builds")
}

// ------------------------------------------------------------------- parts

enum PartCategory {
  FRAME
  MOTOR
  ESC
  FC
  STACK
  VTX
  CAMERA
  RX
  ANTENNA
  PROP
  BATTERY
  OTHER
}

/// The condition of one physical unit -- the half only the owner knows.
/// Whether it is fitted is derived from `build_parts`, never stored.
enum PartCondition {
  SERVICEABLE
  BROKEN
  RETIRED
}

/// A physical thing I own, tracked as inventory rather than as fields on a
/// build. Motors move between quads; flat `frame`/`motors` strings on `builds`
/// cannot express purchases, spares or replacement history.
/// A *kind* of thing owned -- "UAngel X2810 900KV" -- not a count of them.
///
/// How many are held and what condition each is in live on `part_units`,
/// because one condition field cannot describe four motors: mark the row
/// broken and all four are condemned.
model Part {
  id           String       @id @default(uuid()) @db.Uuid
  ownerId      String       @map("owner_id") @db.Uuid
  category     PartCategory
  manufacturer String?
  model        String?
  /// Category-specific and deliberately free-form: a motor has kv and stator
  /// size, a VTX has power levels. Validated per category in libs/shared.
  spec         Json         @default("{}")
  notesMd      String?      @map("notes_md")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Price hangs off the kind: you buy a model at a price, and a per-unit
  /// price would be over-modelling until something is bought twice at
  /// different times for different money.
  sources PartSource[]
  units   PartUnit[]

  @@index([ownerId, category])
  @@map("parts")
}

/// One physical object.
///
/// This is the grain everything else wants: a motor that dies can be marked
/// broken without condemning its three siblings, and an install points at the
/// specific item that was fitted.
model PartUnit {
  id         String        @id @default(uuid()) @db.Uuid
  partId     String        @map("part_id") @db.Uuid
  condition  PartCondition @default(SERVICEABLE)
  /// Free-text marking on the physical item, if it has one.
  label      String?
  acquiredOn DateTime?     @map("acquired_on") @db.Date
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at")

  part     Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  installs BuildPart[]
  /// Flights flown on this unit, when it is a battery pack.
  flights  Flight[]

  @@index([partId])
  @@map("part_units")
}

/// Where a part came from and what it cost. Several rows per part are expected:
/// one marks the actual purchase, the others are price captures from listings.
model PartSource {
  id          String    @id @default(uuid()) @db.Uuid
  partId      String    @map("part_id") @db.Uuid
  vendor      String?
  url         String?
  price       Decimal?  @db.Decimal(10, 2)
  currency    String?
  /// True on the row this part was actually bought through. Cost rollups sum
  /// only these, so a browsed listing never inflates what a build cost.
  isPurchase  Boolean   @default(false) @map("is_purchase")
  purchasedOn DateTime? @map("purchased_on") @db.Date
  quantity    Int       @default(1)
  capturedAt  DateTime  @default(now()) @map("captured_at")

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@map("part_sources")
}

// ------------------------------------------------------- parts on a build

enum InstallReason {
  INITIAL
  REPLACEMENT
  UPGRADE
}

/// An installation, over time -- not a plain link.
///
/// `removed_on` being null is what "currently fitted" means, so one part can
/// move between quads and keep its whole history. This is what makes
/// cost-per-build and "how many times have I replaced the front-right motor"
/// answerable; flat columns on `builds` cannot express any of it.
///
/// A `repairId` column joins this table when the repairs ticket lands.
model BuildPart {
  id          String        @id @default(uuid()) @db.Uuid
  buildId     String        @map("build_id") @db.Uuid
  unitId      String        @map("unit_id") @db.Uuid
  /// Where on the airframe: "motor FR", "arm RL".
  position    String?
  installedOn DateTime      @map("installed_on") @db.Date
  removedOn   DateTime?     @map("removed_on") @db.Date
  reason      InstallReason @default(INITIAL)
  /// The repair this fitting was part of, when it replaced something. This is
  /// what makes "how many times has that crash cost me an arm" answerable.
  repairId    String?       @map("repair_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  build  Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  unit   PartUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting a repair must not delete the history of
  /// what was fitted during it.
  repair Repair?  @relation(fields: [repairId], references: [id], onDelete: SetNull)

  @@index([buildId])
  @@index([unitId])
  @@index([repairId])
  @@map("build_parts")
}

// -------------------------------------------------------------- repairs

enum RepairCause {
  CRASH
  WEAR
  UPGRADE
}

/// Something that went wrong and what putting it right cost.
///
/// Separate from the install rows because a repair is one event that can
/// replace several parts at once -- a hard crash takes an arm, two props and
/// sometimes a motor -- and the money is spent on the event, not per part.
model Repair {
  id            String      @id @default(uuid()) @db.Uuid
  buildId       String      @map("build_id") @db.Uuid
  occurredOn    DateTime    @map("occurred_on") @db.Date
  cause         RepairCause @default(CRASH)
  descriptionMd String?     @map("description_md")
  /// What the repair cost beyond the parts themselves -- a shop bill, or a
  /// replacement bought without being catalogued.
  cost          Decimal?    @db.Decimal(10, 2)
  currency      String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  build    Build       @relation(fields: [buildId], references: [id], onDelete: Cascade)
  /// Installs made as part of this repair.
  installs BuildPart[]

  @@index([buildId, occurredOn])
  @@map("repairs")
}

// --------------------------------------------------------- firmware config

enum ConfigKind {
  /// `diff all` -- only settings changed from default. What Betaflight
  /// recommends keeping, and what is safe-ish to re-apply.
  DIFF
  /// `dump all` -- every setting including defaults.
  DUMP
}

// ---------------------------------------------------------------- media

enum AssetKind {
  IMAGE
  /// A generated derivative. Kept as its own row so it can be served, counted
  /// and deleted like anything else.
  THUMB
}

/// An asset is `ready` only once the bytes are in storage and the API has
/// processed them. A row exists from the moment the upload is presigned, so an
/// upload the browser abandoned is a `PENDING` row to sweep, not a lost object.
enum AssetStatus {
  PENDING
  READY
  FAILED
}

/// One object in S3-compatible storage.
///
/// The bytes never pass through the API: the client is handed a presigned PUT
/// and uploads straight to storage, then asks the API to commit. That removes
/// the request size limit, the memory pressure and the upload DoS surface in
/// one move.
model Asset {
  id         String      @id @default(uuid()) @db.Uuid
  ownerId    String      @map("owner_id") @db.Uuid
  kind       AssetKind   @default(IMAGE)
  status     AssetStatus @default(PENDING)
  /// Key in the bucket. Never a URL: the bucket is private and every read is
  /// a short-lived presigned GET, so the host can change without a migration.
  storageKey String      @unique @map("storage_key")
  /// What the browser called it. Display only — never used to build the key.
  fileName   String?     @map("file_name")
  mime       String?
  sizeBytes  BigInt?     @map("size_bytes")
  width      Int?
  height     Int?
  /// The thumbnail generated from this asset, if it has one.
  thumbId    String?     @unique @map("thumb_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  owner    User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Self-relation: a THUMB belongs to the IMAGE it was derived from, and
  /// dropping the original takes its derivative with it.
  thumb    Asset?      @relation("AssetThumb", fields: [thumbId], references: [id], onDelete: SetNull)
  original Asset?      @relation("AssetThumb")
  links    AssetLink[]
  coverFor Build[]     @relation("BuildCover")
  /// Posts this image is the cover of.
  postCoverFor Post[]  @relation("PostCover")

  @@index([ownerId, status])
  @@map("assets")
}

/// What an asset is attached to.
///
/// Polymorphic on purpose: photos hang off builds today, and off parts,
/// repairs, spots and posts later without a table each.
model AssetLink {
  id          String   @id @default(uuid()) @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  /// build | part | repair | spot | session | post
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id") @db.Uuid
  /// Manual order within a subject's gallery.
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// One asset cannot be attached to the same subject twice.
  @@unique([assetId, subjectType, subjectId])
  @@index([subjectType, subjectId, sortOrder])
  @@map("asset_links")
}

// --------------------------------------------------------- firmware config

/// A Betaflight CLI capture, stored verbatim.
///
/// The raw text is the record; the parsed columns exist so the app can say
/// "this quad is on 4.5.0" without re-parsing on every read. Fields follow
/// Betaflight's own vocabulary rather than inventing names for them.
model Config {
  id         String     @id @default(uuid()) @db.Uuid
  buildId    String     @map("build_id") @db.Uuid
  capturedAt DateTime   @default(now()) @map("captured_at")
  kind       ConfigKind @default(DIFF)
  /// The CLI output exactly as pasted. Never normalised: it is the artefact.
  raw        String
  note       String?

  // --- firmware identity, from the `# Betaflight / ...` version comment
  /// e.g. STM32F405
  fwTarget    String?   @map("fw_target")
  /// e.g. 4.5.0
  fwVersion   String?   @map("fw_version")
  fwBuildDate DateTime? @map("fw_build_date") @db.Date
  /// Short git hash of the firmware build, e.g. c155f5830
  fwGitRev    String?   @map("fw_git_rev")
  /// MSP protocol version the firmware speaks, e.g. 1.46
  mspApi      String?   @map("msp_api")
  /// `# config rev:` -- the board config the firmware was built against
  configRev   String?   @map("config_rev")

  // --- board identity, from the unified-target settings in the body
  /// e.g. BETAFPVF405
  boardName      String? @map("board_name")
  /// Four-letter manufacturer code, e.g. BEFH
  manufacturerId String? @map("manufacturer_id")
  /// Unique to the physical flight controller, so a capture can be matched
  /// back to the board it came from -- or flagged as belonging to another.
  mcuId          String? @map("mcu_id")
  /// `craft_name` as set in Betaflight.
  craftName      String? @map("craft_name")

  createdAt DateTime @default(now()) @map("created_at")

  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@index([buildId, capturedAt])
  @@map("configs")
}

// -------------------------------------------------------------------- jobs

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Background work, queued in Postgres rather than in Redis.
///
/// One process, one worker, a handful of jobs a day: a table claimed with
/// `FOR UPDATE SKIP LOCKED` does everything a broker would, and ships as a
/// migration rather than as another container to run and back up. Not owned by
/// a user — the owner travels in the payload with everything else a handler
/// needs.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  /// Which handler runs it, e.g. `flight-log.import`.
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  /// Not picked up before this. A failed attempt pushes it out as backoff.
  runAfter    DateTime  @default(now()) @map("run_after")
  /// When a worker claimed it. A RUNNING job with a stale lock belonged to a
  /// process that died, and is claimed again.
  lockedAt    DateTime? @map("locked_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, runAfter])
  @@map("jobs")
}

// ----------------------------------------------------------------- flights

/// Which parser reads a log: the radio's EdgeTX CSV, a flight controller's
/// Betaflight blackbox, or a GPX track from any GPS.
enum LogFormat {
  EDGETX_CSV
  BETAFLIGHT_BBL
  GPX
}

enum LogFileStatus {
  /// Reserved and signed; the bytes may not have arrived yet.
  PENDING
  PARSED
  FAILED
}

enum LogImportStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// One batch: everything dropped in at once, processed by one job.
model LogImport {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @map("owner_id") @db.Uuid
  /// The build every flight in the batch belongs to. Null means match each
  /// log's model name against the build names, and leave the rest unassigned.
  /// No foreign key: this records what was asked for, and the worker checks
  /// the build still exists before using it.
  buildId     String?         @map("build_id") @db.Uuid
  /// The day the batch's blackbox logs were flown. A flight controller records
  /// no date, so whoever imports says; EdgeTX logs keep the radio's own.
  flownOn     DateTime?       @map("flown_on") @db.Date
  status      LogImportStatus @default(QUEUED)
  flightCount Int             @default(0) @map("flight_count")
  error       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  finishedAt  DateTime?       @map("finished_at")

  owner User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files LogFile[]

  @@index([ownerId, createdAt])
  @@map("log_imports")
}

/// One log file, kept verbatim in object storage, so a parser fix can re-run
/// over it rather than asking for the SD card again.
model LogFile {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  importId    String?       @map("import_id") @db.Uuid
  format      LogFormat     @default(EDGETX_CSV)
  status      LogFileStatus @default(PENDING)
  storageKey  String        @unique @map("storage_key")
  /// What the radio called it. Display only — never used to build the key.
  fileName    String        @map("file_name")
  sizeBytes   Int           @map("size_bytes")
  /// SHA-256 of the bytes. The whole LOGS folder is dropped in every time, so
  /// this is what makes the second drop import only what is new.
  checksum    String
  /// The radio model the log was recorded under, from the file name.
  modelName   String?       @map("model_name")
  flightCount Int           @default(0) @map("flight_count")
  error       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  import         LogImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  flights        Flight[]   @relation("FlightLog")
  /// Flights a GPX track from this file was added to, rather than stored as.
  trackedFlights Flight[]   @relation("FlightTrack")

  @@unique([ownerId, checksum])
  @@index([importId])
  @@map("log_files")
}

/// One outing: flights less than 90 minutes apart.
///
/// Derived from the flights on every import, so it holds nothing of its own
/// yet — the spot and the notes arrive with V2 Places.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  startedAt DateTime @map("started_at")
  endedAt   DateTime @map("ended_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  flights Flight[]

  @@index([ownerId, startedAt])
  @@map("sessions")
}

/// One pack: a stretch of a log from arming to landing.
///
/// Times are the radio's wall clock, stored as though they were UTC. The radio
/// records no time zone, and guessing one would shift every flight by the
/// difference.
model Flight {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  buildId        String?  @map("build_id") @db.Uuid
  /// The battery pack flown. A log never says which pack was plugged in, so
  /// this is only ever set by hand.
  batteryUnitId  String?  @map("battery_unit_id") @db.Uuid
  logFileId      String   @map("log_file_id") @db.Uuid
  /// The GPX file whose track was added to this flight, when one was: a
  /// track that overlaps a flight from a radio log joins it instead of being
  /// stored as a second flight. SetNull, so deleting that log keeps the flight.
  trackLogFileId String?  @map("track_log_file_id") @db.Uuid
  startedAt      DateTime @map("started_at")
  endedAt        DateTime @map("ended_at")
  durationS      Int      @map("duration_s")
  sampleCount    Int      @map("sample_count")
  /// False for a blackbox log: it records no time of day, only the day it was
  /// said to be flown, so its times order its flights and nothing more.
  timeRecorded   Boolean  @default(true) @map("time_recorded")

  // --- battery and link: these need no GPS
  startVoltage   Float? @map("start_voltage")
  minVoltage     Float? @map("min_voltage")
  endVoltage     Float? @map("end_voltage")
  mahUsed        Int?   @map("mah_used")
  maxCurrentA    Float? @map("max_current_a")
  minLinkQuality Int?   @map("min_link_quality")

  // --- link, sticks and radio: logged by the receiver and the radio
  // themselves, so these arrive even from a quad that sends no telemetry
  minRssiDbm         Int?   @map("min_rssi_dbm")
  minSnrDb           Int?   @map("min_snr_db")
  minDownlinkQuality Int?   @map("min_downlink_quality")
  maxTxPowerMw       Int?   @map("max_tx_power_mw")
  avgThrottlePct     Int?   @map("avg_throttle_pct")
  maxThrottlePct     Int?   @map("max_throttle_pct")
  minRadioVoltage    Float? @map("min_radio_voltage")

  // --- track: only when the quad carries GPS
  hasGps           Boolean @default(false) @map("has_gps")
  distanceM        Float?  @map("distance_m")
  maxAltitudeM     Float?  @map("max_altitude_m")
  maxSpeedKmh      Float?  @map("max_speed_kmh")
  maxHomeDistanceM Float?  @map("max_home_distance_m")

  createdAt DateTime @default(now()) @map("created_at")

  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// SetNull: deleting a quad must not delete the record of having flown it.
  build        Build?    @relation(fields: [buildId], references: [id], onDelete: SetNull)
  /// SetNull for the same reason: deleting a pack keeps the flights.
  batteryUnit  PartUnit? @relation(fields: [batteryUnitId], references: [id], onDelete: SetNull)
  logFile      LogFile   @relation("FlightLog", fields: [logFileId], references: [id], onDelete: Cascade)
  trackLogFile LogFile?  @relation("FlightTrack", fields: [trackLogFileId], references: [id], onDelete: SetNull)

  /// Re-running an import over the same file cannot duplicate a flight.
  @@unique([logFileId, startedAt])
  @@index([ownerId, startedAt])
  @@index([sessionId])
  @@index([buildId])
  @@index([batteryUnitId])
  @@index([trackLogFileId])
  @@map("flights")
}

// ------------------------------------------------------------------ spots

/// The ground a spot is. Chosen from a short list rather than typed, so the
/// map can be filtered by it.
enum SpotTerrain {
  FIELD
  PARK
  BANDO
  FOREST
  QUARRY
  MOUNTAIN
  WATER
  URBAN
  TRACK
  OTHER
}

enum SpotHazard {
  POWERLINES
  PEOPLE
  TRAFFIC
  TREES
  WATER
  ANIMALS
  AIRSPACE
  PRIVATE_LAND
}

/// Whether flying there is allowed, as far as the owner knows.
enum SpotAccess {
  OPEN
  ASK_FIRST
  RESTRICTED
  UNKNOWN
}

/// A place to fly, written by hand.
///
/// Kept apart from flights on purpose: a spot is somewhere, a flight is
/// something that happened. Nothing here is derived from a log.
model Spot {
  id            String       @id @default(uuid()) @db.Uuid
  ownerId       String       @map("owner_id") @db.Uuid
  name          String
  slug          String
  /// Plain numerics rather than PostGIS: nothing queries by distance yet, and
  /// Prisma cannot read a geography column without raw SQL. Six decimal
  /// places is about 11 cm.
  lat           Decimal      @db.Decimal(9, 6)
  lng           Decimal      @db.Decimal(9, 6)
  /// Nearest town or region, as the owner would say it.
  locality      String?
  terrain       SpotTerrain?
  access        SpotAccess   @default(UNKNOWN)
  /// 1 (wide open, easy) to 5 (tight and unforgiving).
  difficulty    Int?         @db.SmallInt
  hazards       SpotHazard[] @default([])
  descriptionMd String?      @map("description_md")
  /// Parking, the way in, who to ask.
  accessNotesMd String?      @map("access_notes_md")
  visibility    Visibility   @default(PRIVATE)
  /// Captured from a GPS fix with nothing filled in yet. Created private, and
  /// anything that lists spots publicly must skip drafts.
  isDraft       Boolean      @default(false) @map("is_draft")
  /// A flight video on YouTube: its 11-character id and an optional start
  /// time, never the pasted URL. One per spot, by being these two columns.
  youtubeVideoId String?     @map("youtube_video_id") @db.VarChar(11)
  youtubeStartS  Int?        @map("youtube_start_s")
  /// The video's thumbnail, fetched once by the `spot.cover` job and kept in
  /// our own bucket, so a card showing it never contacts YouTube. A key, never
  /// a URL: every read is a short-lived presigned GET.
  coverStorageKey String?    @unique @map("cover_storage_key")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  comments     Comment[]
  commentReads CommentRead[]

  @@unique([ownerId, slug])
  @@index([ownerId, updatedAt])
  @@map("spots")
}

// ---------------------------------------------------------------- comments

/// A question on a spot or a build, or a reply to one. Belongs to exactly one
/// subject — `spot_id` or `build_id` — which a CHECK constraint in the
/// migration enforces, since Prisma cannot express it; and goes when its
/// subject does. Replies go one level deep: a reply's parent is always a
/// question, never another reply.
model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  spotId    String?   @map("spot_id") @db.Uuid
  buildId   String?   @map("build_id") @db.Uuid
  postId    String?   @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  /// Null for a question; the question's id for a reply.
  parentId  String?   @map("parent_id") @db.Uuid
  body      String
  /// Set by the question's asker or the subject's owner, on at most one reply per question.
  isAnswer  Boolean   @default(false) @map("is_answer")
  /// When its author last reworded it; null if never.
  editedAt  DateTime? @map("edited_at")
  /// Set when a question's asker deleted it after others had replied: its
  /// words are cleared and the replies stay, under "Question deleted".
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  spot    Spot?     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  build   Build?    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  post    Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Deleting a question takes its replies with it.
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([spotId, createdAt])
  @@index([buildId, createdAt])
  @@index([postId, createdAt])
  @@index([parentId])
  @@map("comments")
}

/// When a user last read a subject's comments — what the unread badges count
/// from. One subject per row, as for comments; its own id, since a composite
/// key cannot include a nullable column.
model CommentRead {
  id      String   @id @default(uuid()) @db.Uuid
  spotId  String?  @map("spot_id") @db.Uuid
  buildId String?  @map("build_id") @db.Uuid
  postId  String?  @map("post_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  readAt  DateTime @default(now()) @map("read_at")

  spot  Spot?  @relation(fields: [spotId], references: [id], onDelete: Cascade)
  build Build? @relation(fields: [buildId], references: [id], onDelete: Cascade)
  post  Post?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spotId, userId])
  @@unique([buildId, userId])
  @@unique([postId, userId])
  @@map("comment_reads")
}

// ------------------------------------------------------------------- posts

/// A blog post: markdown a pilot wrote, optionally about some of their own
/// builds. Visibility works as it does for a build — Private is a draft only
/// its author sees, Unlisted opens for anyone with the link, signed in or not,
/// and Public is also listed on the blog.
model Post {
  id          String     @id @default(uuid()) @db.Uuid
  authorId    String     @map("author_id") @db.Uuid
  title       String
  slug        String
  /// A line or two for the blog list and link previews.
  summary     String?
  bodyMd      String     @default("") @map("body_md")
  visibility  Visibility @default(PRIVATE)
  /// Set the first time the post leaves Private, and kept after that: the day
  /// it was published, not the last day it was made public again.
  publishedAt DateTime?  @map("published_at")
  /// The cover image, one of the post's own uploaded images. SetNull, so
  /// deleting the image does not delete the post.
  coverAssetId String?   @map("cover_asset_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cover  Asset?      @relation("PostCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  builds PostBuild[]
  likes  Like[]
  comments     Comment[]
  commentReads CommentRead[]

  @@unique([authorId, slug])
  @@index([authorId, updatedAt])
  @@index([visibility, publishedAt])
  @@map("posts")
}

/// A build a post is about. Goes when either the post or the build does.
model PostBuild {
  postId    String @map("post_id") @db.Uuid
  buildId   String @map("build_id") @db.Uuid
  /// The author's order.
  sortOrder Int    @default(0) @map("sort_order")

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@id([postId, buildId])
  @@index([buildId])
  @@map("post_builds")
}

// ------------------------------------------------------------------- likes

/// One pilot liking a post or a build. Belongs to exactly one subject —
/// `post_id` or `build_id`, which a CHECK constraint in the migration enforces
/// as for comments — and goes when the subject or the user does.
model Like {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String?  @map("post_id") @db.Uuid
  buildId   String?  @map("build_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post  Post?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  build Build? @relation(fields: [buildId], references: [id], onDelete: Cascade)

  /// One like per pilot per subject.
  @@unique([postId, userId])
  @@unique([buildId, userId])
  @@map("likes")
}
