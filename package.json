{
  "name": "spothub-fpv",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "cross-env NX_LOAD_DOT_ENV_FILES=false nx run-many -t serve --projects=api,client --parallel=2",
    "dev:api": "cross-env NX_LOAD_DOT_ENV_FILES=false nx serve api",
    "dev:client": "cross-env NX_LOAD_DOT_ENV_FILES=false nx serve client",
    "build": "nx run-many -t build --projects=api,client --configuration=production",
    "lint": "nx run-many -t lint --all --max-warnings=0",
    "lint:fix": "nx run-many -t lint --all --fix",
    "format": "prettier --write \"apps/**/*.{ts,html,scss}\" \"libs/**/*.ts\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,html,scss}\" \"libs/**/*.ts\"",
    "typecheck": "tsc -p apps/api/tsconfig.app.json --noEmit && tsc -p apps/client/tsconfig.app.json --noEmit && tsc -p prisma/tsconfig.json --noEmit",
    "test": "nx run api:test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "ts-node -P prisma/tsconfig.json prisma/seed.ts",
    "db:seed:undo": "ts-node -P prisma/tsconfig.json prisma/seed.ts --undo"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "22.1.6",
