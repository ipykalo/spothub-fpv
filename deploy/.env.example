# The production environment, as it lives at /opt/spothub/.env on the server.
#
# Copy this there, fill it in and `chmod 600` it. It is the only place any of
# these values exist: nothing here is ever committed, and the compose file
# reads every one of them from this file.

# --- Where the site lives --------------------------------------------------
# No scheme and no trailing slash: the compose file and the Caddyfile build
# the URLs from these.
SITE_DOMAIN=example.com
# Object storage's own name. The browser uploads straight to it on a presigned
# URL, so it has to resolve publicly and have its own certificate.
STORAGE_DOMAIN=storage.example.com

# --- Which images to run ---------------------------------------------------
# `master` is the production branch, and this tag follows it: a release is a
# merge from `dev` into `master`, and the next `docker compose pull` picks it
# up. Pin to `sha-<commit>` to hold a version still, and to roll back — that
# tag is immutable where a branch tag is not.
SPOTHUB_TAG=master

# --- Database --------------------------------------------------------------
POSTGRES_USER=spothub
POSTGRES_DB=spothub
# openssl rand -hex 24 — hex, because it is spliced into DATABASE_URL
POSTGRES_PASSWORD=

# --- Auth ------------------------------------------------------------------
# The same OAuth client as development, with the production redirect URI added
# at https://console.cloud.google.com/apis/credentials:
#   https://<SITE_DOMAIN>/api/auth/google/callback   (authorised redirect URI)
#   https://<SITE_DOMAIN>                            (authorised JS origin)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in, as a fresh database starts: read once, then changed on the
# Admin page. With OPEN_REGISTRATION=true, anyone with a Google account;
# otherwise only the comma-separated ALLOWED_EMAILS. Off and empty means
# nobody, which is the intended default rather than a mistake.
OPEN_REGISTRATION=false
ALLOWED_EMAILS=

# openssl rand -hex 48, twice — and different from the development ones.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Object storage --------------------------------------------------------
# The endpoints themselves are not here: the compose file sets them, because
# they are fixed by the shape of the deployment rather than by taste. The API
# reads and writes at http://minio:9000 inside the network, and signs the
# browser's upload URLs against https://<STORAGE_DOMAIN>.
S3_BUCKET=spothub-media
S3_REGION=us-east-1
# MinIO's root credentials. openssl rand -hex 24 for the secret; the key
# may be anything, but it is a credential, so do not leave it as `minioadmin`.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Off-site backups -------------------------------------------------------
# A Cloudflare R2 bucket in the EU jurisdiction, and a token that can read and
# write that bucket only. backup.sh and restore-test.sh read these; see
# README.md, "Backups". The endpoint is the bucket's `.eu.` S3 address.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=spothub-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Optional: a dead-man's switch for the nightly backup. A check's ping URL
# (healthchecks.io, or anything that takes a GET and a GET to .../fail).
# backup.sh reports success to it and failure to its /fail; the check emails
# when a failure arrives or when nothing arrives at all. Empty: no reports.
BACKUP_HEARTBEAT_URL=

# Optional: where official exchange rates come from (the National Bank of
# Ukraine) and how long to wait for an answer, in milliseconds. Leave both
# commented out to use these defaults.
# NBU_RATES_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchangenew
# NBU_RATES_TIMEOUT_MS=10000
