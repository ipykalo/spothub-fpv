# Caddy in front of SpotHub FPV.
#
# TLS is automatic: Caddy asks Let's Encrypt for a certificate for each site
# name below the first time it is asked for, and renews it without being told.
# That is the whole reason it is here rather than nginx.
#
# Two names, because the browser uploads straight to object storage on a
# presigned URL and cannot resolve a container: the site itself, and storage.
# No `email` option: Let's Encrypt stopped sending expiry notices in 2025, so
# an address given to it would buy nothing, and Caddy renews on its own.

{$SITE_DOMAIN} {
	encode zstd gzip

	# The API keeps its own `/api` prefix, so the path is passed through
	# unchanged — the routes really are `/api/...` on the other side.
	handle /api/* {
		reverse_proxy api:3000
	}

	# Everything else is the Angular server: the public pages rendered per
	# request, the browser bundle beside them, and robots.txt and sitemap.xml.
	handle {
		reverse_proxy client:4000
	}

	# Sent on every response. A page's Content-Security-Policy is not here:
	# it carries a nonce made fresh for each response, so the client server
	# sends it (apps/client/src/content-security.ts). The API sends its own,
	# through helmet.
	#
	# HSTS starts at a day. It is hard to undo — a mistake locks browsers out
	# of the domain for as long as max-age says — so it grows only once a day
	# has passed without trouble; no includeSubDomains or preload until then.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=86400"
		Cross-Origin-Opener-Policy same-origin
		# Location is asked for at the field ("Add location", "Show my
		# location"); nothing else the browser offers is used.
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}
}

# Redirects the bare `www` to the canonical name, so the blog is indexed once.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$STORAGE_DOMAIN} {
	# A presigned PUT signs the headers it will send, so nothing may be added
	# or rewritten on the way through. `reverse_proxy` passes the body and the
	# Authorization query string untouched.
	reverse_proxy minio:9000

	# Photos and logs are large; the default limit would refuse them.
	request_body {
		max_size 100MB
	}
}
