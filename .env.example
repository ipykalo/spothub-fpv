# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# --- Database -------------------------------------------------------------
POSTGRES_USER=fpv
POSTGRES_PASSWORD=fpv
POSTGRES_DB=fpv
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fpv:fpv@localhost:5432/fpv?schema=public

# --- Client ---------------------------------------------------------------
# Where the browser app lives. Used for CORS and post-login redirects.
CLIENT_URL=http://localhost:4200

# --- Auth -----------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# The single gate on registration. Comma-separated. Empty means nobody can
# sign in; "*" opens registration to anyone with a Google account.
ALLOWED_EMAILS=

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)

# --- Object storage (unused until the media ticket) -----------------------
# In development the browser and the API reach MinIO at the same address, so
# there is nothing to split. On a server they differ, and the API then also
# sets S3_PUBLIC_ENDPOINT — the address the browser's presigned uploads are
# signed against. See deploy/docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=spothub-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Blackbox decoding ----------------------------------------------------
# Betaflight's blackbox_decode turns .bbl logs into CSV; the API image builds
# it in. A machine without it (Windows has no C compiler to build it with)
# runs the same program through Docker: build it once with
# `npm run decoder:build` and name that image here. Empty uses the path.
BLACKBOX_DECODE_PATH=blackbox_decode
BLACKBOX_DECODE_DOCKER_IMAGE=spothub-blackbox-decode
